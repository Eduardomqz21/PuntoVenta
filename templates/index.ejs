
<%- include('partials/header') %>

<div class="container mt-5 pt-4">
    <div class="text-center mb-5 animate-fade-up">
        <h2 class="fw-bold display-5"><%= category %></h2>
        <p class="text-muted">Descubre las últimas tendencias en moda.</p>
    </div>
    
    <div class="row g-4">
        <% if (products.length === 0) { %>
            <div class="col-12 text-center animate-fade-up">
                <p class="text-muted fs-5">No hay productos en esta categoría por el momento.</p>
            </div>
        <% } %>
        <% products.forEach((product, index) => { 
            let delayClass = 'delay-' + ((index % 6) + 1);
        %>
            <div class="col-md-4 col-sm-6 animate-fade-up <%= delayClass %>">
                <div class="card h-100">
                    <% if (product.Imagen) { %>
                        <img src="<%= product.Imagen %>" class="card-img-top" alt="<%= product.Nombre %>" style="height: 280px;">
                    <% } else { %>
                        <div class="no-image-placeholder">
                            <i class="bi bi-image text-muted fs-1 mb-2"></i>
                            <span style="position:absolute; bottom:20px;">Sin Imagen</span>
                        </div>
                    <% } %>
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0"><%= product.Nombre %></h5>
                            <span class="badge bg-light text-dark border"><%= product.Categoria %></span>
                        </div>
                        <p class="card-text text-muted mb-4 flex-grow-1"><%= product.Descripcion %></p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <span class="fs-4 fw-bold text-dark">$<%= parseFloat(product.Precio).toFixed(2) %></span>
                            <button class="btn btn-primary shadow-sm" onclick="addToCart('<%= product.ID %>', '<%= product.Nombre %>', <%= parseFloat(product.Precio) %>)">
                                Añadir <i class="bi bi-cart-plus ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('partials/footer') %>
