<%- include('partials/header') %>

<main class="container my-5 pt-2">
    <!-- Encabezado de Sección y Búsqueda -->
    <div class="row align-items-center mb-5 animate-fade-up">
        <div class="col-md-8 text-center text-md-start">
            <h1 class="fw-bold display-6 mb-2 text-dark">
                <%= category %>
            </h1>
            <p class="text-muted mb-0">Descubre las últimas tendencias en moda con recolección física en tienda.</p>
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                <div class="mt-2">
                    <span class="badge bg-light text-dark border px-3 py-2">
                        Filtro activo: "<%= searchQuery %>"
                        <a href="/" class="text-danger ms-2 text-decoration-none" title="Limpiar búsqueda">
                            <i class="bi bi-x-circle-fill"></i> Limpiar
                        </a>
                    </span>
                </div>
            <% } %>
        </div>
        <div class="col-md-4 text-center text-md-end mt-3 mt-md-0">
            <div class="d-inline-flex gap-2">
                <a href="/categoria/hombre" class="btn btn-sm <%= (typeof category !== 'undefined' && category.toLowerCase() === 'hombre') ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">Hombre</a>
                <a href="/categoria/mujer" class="btn btn-sm <%= (typeof category !== 'undefined' && category.toLowerCase() === 'mujer') ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">Mujer</a>
                <a href="/categoria/descuento" class="btn btn-sm <%= (typeof category !== 'undefined' && category.toLowerCase() === 'descuento') ? 'btn-danger' : 'btn-outline-danger' %> rounded-pill px-3">Descuentos</a>
            </div>
        </div>
    </div>
    
    <!-- Cuadrícula de Productos -->
    <div class="row g-4">
        <% if (products.length === 0) { %>
            <div class="col-12 text-center py-5 animate-fade-up">
                <div class="py-5 bg-white rounded-4 shadow-sm border p-4">
                    <i class="bi bi-search text-muted" style="font-size: 3.5rem;"></i>
                    <h4 class="fw-bold mt-3 text-secondary">No encontramos prendas en esta sección</h4>
                    <p class="text-muted">Prueba buscando con otro término o revisa todas nuestras categorías disponibles.</p>
                    <a href="/" class="btn btn-primary rounded-pill px-4 mt-2">
                        <i class="bi bi-grid-fill me-1"></i> Ver Todo el Catálogo
                    </a>
                </div>
            </div>
        <% } %>

        <% products.forEach((product, index) => { 
            let delayClass = 'delay-' + ((index % 6) + 1);
            let isOutOfStock = (product.Stock <= 0);
            let isLowStock = (product.Stock > 0 && product.Stock <= 3);
        %>
            <div class="col-lg-3 col-md-4 col-sm-6 animate-fade-up <%= delayClass %>">
                <div class="card h-100 product-card shadow-sm border-0 position-relative <%= isOutOfStock ? 'card-out-of-stock' : '' %>">
                    <!-- Badges Flotantes de Estado / Descuento / Stock -->
                    <div class="position-absolute top-0 start-0 m-3 z-2 d-flex flex-column gap-1">
                        <span class="badge bg-white text-dark shadow-sm border px-2 py-1 rounded-pill small">
                            <%= product.Categoria %>
                        </span>
                        <% if (product.Categoria.toLowerCase() === 'descuento') { %>
                            <span class="badge bg-danger shadow-sm rounded-pill small">
                                <i class="bi bi-percent"></i> Oferta
                            </span>
                        <% } %>
                    </div>

                    <div class="position-absolute top-0 end-0 m-3 z-2">
                        <% if (isOutOfStock) { %>
                            <span class="badge bg-danger shadow-sm px-3 py-1 rounded-pill small fw-bold">
                                <i class="bi bi-slash-circle me-1"></i> Agotado
                            </span>
                        <% } else if (isLowStock) { %>
                            <span class="badge bg-warning text-dark shadow-sm px-2 py-1 rounded-pill small fw-semibold">
                                <i class="bi bi-fire text-danger me-1"></i> ¡Últimas <%= product.Stock %>!
                            </span>
                        <% } else { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle shadow-sm px-2 py-1 rounded-pill small">
                                <i class="bi bi-check-circle me-1"></i> Stock: <%= product.Stock %>
                            </span>
                        <% } %>
                    </div>

                    <!-- Imagen o Placeholder Degradado -->
                    <div class="product-image-wrapper overflow-hidden position-relative">
                        <% if (product.Imagen) { %>
                            <img src="<%= product.Imagen %>" class="card-img-top product-img" alt="<%= product.Nombre %>" loading="lazy">
                        <% } else { %>
                            <div class="no-image-placeholder">
                                <i class="bi bi-bag-heart text-muted fs-1 mb-2"></i>
                                <span class="placeholder-label">Sin Fotografía</span>
                            </div>
                        <% } %>
                    </div>

                    <!-- Cuerpo de la Tarjeta -->
                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold mb-1 text-dark text-truncate" title="<%= product.Nombre %>">
                            <%= product.Nombre %>
                        </h5>
                        <p class="card-text text-muted small mb-3 flex-grow-1 product-desc">
                            <%= product.Descripcion || 'Prenda de alta calidad confeccionada para brindar estilo y máxima comodidad.' %>
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <div>
                                <small class="text-muted d-block line-height-1">Precio</small>
                                <span class="fs-4 fw-bold text-dark">$<%= parseFloat(product.Precio).toFixed(2) %> <small class="fs-6 text-muted font-monospace">MXN</small></span>
                            </div>

                            <% if (isOutOfStock) { %>
                                <button class="btn btn-secondary rounded-pill px-3 disabled" disabled title="Producto sin existencias">
                                    <i class="bi bi-slash-circle me-1"></i> Agotado
                                </button>
                            <% } else { %>
                                <button class="btn btn-primary rounded-pill px-3 shadow-sm btn-add-cart" 
                                    data-id="<%= product.ID %>"
                                    data-nombre="<%= product.Nombre %>"
                                    data-precio="<%= product.Precio %>"
                                    data-stock="<%= product.Stock %>"
                                    data-imagen="<%= product.Imagen || '' %>">
                                    <span>Añadir</span> <i class="bi bi-cart-plus ms-1"></i>
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>
