
<%- include('partials/header') %>

<div class="container mt-5 pt-4 animate-fade-up">
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-bag-check fs-2 me-3 text-primary"></i>
        <h2 class="fw-bold mb-0">Tu Bolsa de Compras</h2>
    </div>
    
    <div class="row mt-4 g-4">
        <div class="col-lg-8 animate-fade-up delay-1">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div id="cart-items-container">
                        <!-- Rendered by cart.js -->
                    </div>
                    <div class="text-end mt-4 pt-3 border-top">
                        <h4 class="fw-bold">Total a Pagar: <span class="text-primary">$<span id="cart-total">0.00</span></span></h4>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 animate-fade-up delay-2">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-1"><i class="bi bi-truck me-2"></i>Datos de Entrega</h5>
                    <p class="small text-white-50 mb-4">Pago y entrega directamente en tienda física.</p>
                    
                    <form id="checkout-form">
                        <div class="mb-3">
                            <label class="form-label text-white-50 small text-uppercase fw-bold">Nombre Completo</label>
                            <input type="text" class="form-control bg-white border-0" id="cliente-nombre" placeholder="Ej. Ana López" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-white-50 small text-uppercase fw-bold">Teléfono de Contacto</label>
                            <input type="tel" class="form-control bg-white border-0" id="cliente-telefono" placeholder="Ej. 55 1234 5678" required>
                        </div>
                        <button type="submit" class="btn btn-light w-100 fw-bold py-3 text-primary shadow">
                            Confirmar Pedido <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg border-radius-xl">
      <div class="modal-body text-center p-5">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold mb-3">¡Pedido Confirmado!</h3>
        <p class="text-muted mb-4">Hemos recibido tu orden. Te esperamos en la tienda para realizar el pago y entregarte tus productos.</p>
        <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">Volver al Catálogo</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
